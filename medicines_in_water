<script>

function checkQuiz(){

    const options =
        document.getElementsByName("q");

    let selected = "";

    for(let option of options){

        if(option.checked){

            selected = option.value;

        }

    }

    const result =
        document.getElementById("result");

    if(selected === "b"){

        result.innerHTML =
        "✅ Correct! Approved medicine take-back or collection programs are an appropriate option where available.";

        result.style.color = "#008f80";

    }

    else if(selected === ""){

        result.innerHTML =
        "⚠️ Please select an answer.";

        result.style.color = "#e68a00";

    }

    else{

        result.innerHTML =
        "❌ Not quite. Medicine disposal should follow local official guidance.";

        result.style.color = "#d65c45";

    }

}


/* Simple scroll reveal */

const cards =
document.querySelectorAll(
".source-card, .effect, .solution, .step, .action-card"
);

const observer =
new IntersectionObserver(
(entries)=>{

entries.forEach(entry=>{

if(entry.isIntersecting){

entry.target.style.opacity="1";
entry.target.style.transform="translateY(0)";

}

});

},
{threshold:.12}
);


cards.forEach(card=>{

card.style.opacity="0";
card.style.transform="translateY(30px)";
card.style.transition="all .7s ease";

observer.observe(card);

});

</script>

